  <!DOCTYPE html>
  <html lang="en" class="dark">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Traductor Binario</title>
      <meta name="description" content="Traductor Binario - Binary ↔ Text translator" />
      <meta name="robots" content="index, follow" />
      <meta property="og:title" content="Traductor Binario" />
      <meta property="og:description" content="Traductor Binario - binary/text translator" />
      <meta property="og:type" content="website" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content="Traductor Binario" />
      <meta name="twitter:description" content="Traductor Binario - binary/text translator" />
      <link rel="icon" type="image/svg+xml" href="https://chino-san.app/favicon.svg" />
      <link rel="preconnect" href="https://fonts.googleapis.com/" />
      <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
      <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&display=swap" rel="stylesheet" />
      <style>
        /* Minimal styles to keep layout readable when opened locally */
        :root{--bg:#0b1220;--card:#071022;--muted:rgba(230,238,248,0.6);--accent:#0f1724}
        html,body{height:100%;margin:0;font-family:Inter, 'IBM Plex Sans', system-ui, sans-serif;background:var(--bg);color:#e6eef8}
        .container{max-width:1024px;margin:24px auto;padding:20px}
        .card{background:var(--card);border-radius:8px;padding:16px;border:1px solid rgba(255,255,255,0.04)}
        textarea{width:100%;min-height:200px;padding:12px;border-radius:6px;border:1px solid rgba(255,255,255,0.06);background:#06111a;color:inherit}
        .row{display:flex;gap:12px}
        .col{flex:1}
        .controls{display:flex;gap:8px;align-items:center;margin-bottom:8px}
        .btn{padding:8px 12px;border-radius:6px;border:1px solid rgba(255,255,255,0.06);background:var(--accent);color:inherit;cursor:pointer}
        .muted{color:var(--muted);font-family:monospace;font-size:12px}
        .mode{display:flex;gap:8px;align-items:center}
        .status{font-family:monospace;font-size:12px;color:var(--muted)}
      </style>
    </head>
    <body>
      <div id="root" class="container">
        <div class="card">
          <header style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
            <div>
              <h1 style="margin:0;font-size:18px;letter-spacing:1px">T3RMINAL</h1>
              <div style="font-family:monospace;font-size:12px;color:rgba(230,238,248,0.7)">BINARY // TRANSLATOR // V1.0</div>
            </div>
            <div style="font-family:monospace;font-size:13px;color:rgba(230,238,248,0.7)">SYS.STATUS: ONLINE</div>
          </header>

          <div class="row">
            <div class="col">
              <div class="controls">
                <strong class="muted">Input</strong>
                <div class="mode">
                  <label class="muted">Mode:</label>
                  <select id="modeSelect">
                    <option value="auto">Auto</option>
                    <option value="bin2text">Bin → Text</option>
                    <option value="text2bin">Text → Bin</option>
                  </select>
                </div>
                <button class="btn" id="clearBtn" type="button">Clear</button>
              </div>
              <textarea id="textarea-input" placeholder="e.g. 01001000 01100101 01101100 01101100 01101111"></textarea>
            </div>

            <div class="col">
              <div class="controls">
                <strong class="muted">Output</strong>
                <button class="btn" id="copyBtn" type="button" disabled>Copiar resultado</button>
              </div>
              <textarea id="textarea-output" placeholder="Waiting for input..." readonly></textarea>
            </div>
          </div>

          <footer style="margin-top:12px;font-size:12px;color:rgba(230,238,248,0.6);display:flex;justify-content:space-between;align-items:center">
            <div>Local processing only. No data leaves your machine.</div>
            <div style="font-family:monospace">Binary ↔ Text</div>
          </footer>
        </div>
      </div>

    <script>
      // Conversion helpers
      function binToText(bin){
        return bin.trim().split(/\s+/).map(b=>{
          const n = parseInt(b,2);
          return Number.isNaN(n) ? '' : String.fromCharCode(n)
        }).join('')
      }
      function textToBin(text){
        return Array.from(text).map(c=>c.charCodeAt(0).toString(2).padStart(8,'0')).join(' ')
      }

      const input = document.getElementById('textarea-input')
      const output = document.getElementById('textarea-output')
      const clearBtn = document.getElementById('clearBtn')
      const copyBtn = document.getElementById('copyBtn')
      const modeSelect = document.getElementById('modeSelect')

      function update(){
        const v = input.value
        const mode = modeSelect.value
        let out = ''
        if(mode === 'bin2text') out = binToText(v)
        else if(mode === 'text2bin') out = textToBin(v)
        else {
          // auto-detect: if input contains only 0/1 and spaces, treat as binary
          const compact = v.replace(/\s+/g,' ')
          if(compact.length>0 && /^[\s01]+$/.test(compact)) out = binToText(v)
          else out = textToBin(v)
        }
        output.value = out || ''
        copyBtn.disabled = !output.value
      }

      input.addEventListener('input', update)
      modeSelect.addEventListener('change', update)
      clearBtn.addEventListener('click', ()=>{ input.value=''; update(); input.focus() })
      copyBtn.addEventListener('click', ()=>{ navigator.clipboard?.writeText(output.value) })

      // initial state
      update()
    </script>
    </body>
</html>
